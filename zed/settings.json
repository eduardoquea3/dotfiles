{
	"ui_font_weight": 600.0,
	"cli_default_open_behavior": "existing_window",
	"collaboration_panel": {
		"dock": "left"
	},
	"agent": {
		"dock": "right",
		"favorite_models": [],
		"model_parameters": []
	},
	"git_panel": {
		"dock": "left"
	},
	"agent_servers": {
		"codex-acp": {
			"type": "registry"
		},
		"claude-acp": {
			"type": "registry",
			"default_model": "haiku",
			"favorite_models": ["haiku"]
		},
		"opencode": {
			"type": "extension",
			"default_model": "openai/gpt-5.4-mini",
			"default_config_options": {
				"effort": "medium",
				"model": "openai/gpt-5.4-mini"
			},
			"favorite_config_option_values": {
				"model": ["openai/gpt-5.4-mini"]
			}
		}
	},
	"context_servers": {
		"mcp-server-context7": {
			"enabled": true,
			"settings": {
				"context7_api_key": "$CONTEXT7_API_KEY"
			}
		}
	},
	"soft_wrap": "editor_width",
	"icon_theme": "Flow Deep",
	"vim_mode": true,
	"base_keymap": "Cursor",
	"multi_cursor_modifier": "cmd_or_ctrl",
	"gutter": {
		"line_numbers": true,
		"min_line_number_digits": 0,
		"folds": false,
		"runnables": false
	},
	"cursor_blink": false,
	"buffer_font_family": "JetBrainsMono Nerd Font Mono",
	"ui_font_family": "JetBrainsMono Nerd Font Mono",
	"ui_font_size": 14.0,
	"buffer_font_size": 12.0,
	"terminal": {
		"font_size": 12.0,
		"font_family": "JetBrainsMono Nerd Font Mono"
	},
	"indent_guides": {
		"enabled": false
	},
	"project_panel": {
		"dock": "left",
		"indent_guides": {
			"show": "never"
		},
		"default_width": 300,
		"hide_root": true,
		"auto_fold_dirs": false,
		"starts_open": false,
		"sticky_scroll": false,
		"scrollbar": {
			"show": "never"
		}
	},
	"toolbar": {
		"breadcrumbs": false,
		"agent_review": false,
		"code_actions": false,
		"quick_actions": false,
		"selections_menu": false
	},
	"git": {
		"inline_blame": {
			"show_commit_summary": true
		}
	},
	"tabs": {
		"git_status": true,
		"show_diagnostics": "all",
		"file_icons": true
	},
	"inlay_hints": {
		"enabled": false,
		"show_type_hints": false,
		"show_other_hints": false
	},
	"theme": "Kanso Zen",
	"edit_predictions": {
		"provider": "zed"
	},
	"lsp": {
		"vtsls": {
			"settings": {
				"typescript": {
					"updateImportsOnFileMove": {
						"enabled": "always"
					}
				},
				"javascript": {
					"updateImportsOnFileMove": {
						"enabled": "always"
					}
				}
			},
			"enable_lsp_tasks": true
		},
		"biome": {
			"settings": {
				"organize_imports_on_save": true,
				"fix_on_save": true,
				"format_on_save": true
			}
		},
		"pyrefly": {
			"binary": {
				"path": ".venv/bin/pyrefly",
				"arguments": ["lsp"]
			},
			"settings": {
				"python": {
					"pythonPath": ".venv/bin/python"
				},
				"pyrefly": {
					"project_includes": ["src/**/*.py", "tests/**/*.py"],
					"project_excludes": ["**/.[!/.]*", "**/*venv/**"],
					"search_path": ["src"],
					"ignore_errors_in_generated_code": true
				}
			}
		},
		"tailwindcss-language-server": {
			"settings": {
				"classAttributes": [
					"groupClass",
					"slotClass",
					"class",
					"className",
					"classList",
					"classLabel",
					"classContainer",
					"labelClass",
					"containerClass",
					"wrapperClass",
					"inputClass",
					"buttonClass",
					"iconClass",
					"headerClass",
					"footerClass",
					"bodyClass",
					"cardClass",
					"modalClass",
					"overlayClass"
				],
				"experimental": {
					"classRegex": [
						["class:\\s*\"([^\"]*)\""],
						["className:\\s*\"([^\"]*)\""],
						["labelClass:\\s*\"([^\"]*)\""],
						["tw`([^`]*)", "([\"'`][^\"'`]*.*?[\"'`])"],
						["cn\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
					]
				}
			}
		}
	},
	"languages": {
		"JavaScript": {
			"language_servers": [
				"tsgo",
				"!vtsls",
				"!eslint",
				"!typescript-language-server",
				"biome",
				"..."
			],
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TypeScript": {
			"language_servers": [
				"tsgo",
				"!vtsls",
				"!eslint",
				"!typescript-language-server",
				"biome",
				"..."
			],
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TSX": {
			"language_servers": [
				"tsgo",
				"!vtsls",
				"!eslint",
				"!typescript-language-server",
				"biome",
				"..."
			],
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"JSON": { "formatter": { "language_server": { "name": "biome" } } },
		"JSONC": { "formatter": { "language_server": { "name": "biome" } } },
		"Python": { "language_servers": ["pyrefly", "ruff", "!pyright", "!pylsp"] }
	},
	"title_bar": {
		"show_onboarding_banner": false,
		"show_menus": false
	},
	"outline_panel": {
		"dock": "left",
		"default_width": 300,
		"indent_guides": {
			"show": "never"
		}
	},
	"scrollbar": {
		"show": "never"
	},
	"file_finder": {
		"modal_max_width": "large"
	},
	"selection_highlight": false,
	"drag_and_drop_selection": {
		"enabled": false
	},
	"seed_search_query_from_cursor": "never",
	"current_line_highlight": "none",
	"show_whitespaces": "none",
	"auto_indent_on_paste": false,
	"show_completion_documentation": false,
	"lsp_document_colors": "background",
	"extend_comment_on_newline": false,
	"horizontal_scroll_margin": 1,
	"vertical_scroll_margin": 1
}
