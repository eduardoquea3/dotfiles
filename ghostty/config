# Generated by Spectre - Ghostty Config Generator
# https://github.com/imrajyavardhan12/spectre-ghostty-config
# Theme: GitHub Dark

# Fonts
font-family = "Dankono Nerd Font"
font-family-bold = "Dankono Nerd Font"
font-family-italic = "Dankono Nerd Font"
font-size = 9

# Cursor
cursor-style = bar
cursor-style-blink = true
cursor-opacity = 0.8

# Window
window-decoration = none
window-padding-x = 1
window-padding-balance = true
window-title-font-family = "Dankono Nerd Font"
window-subtitle = working-directory
background-opacity = 1
background-blur-radius = 20

# Shell
shell-integration = zsh

# Colors
theme = Ayu
background = #101216
foreground = #8b949e
cursor-color = #c9d1d9
cursor-text = #101216
selection-background = #3b5070
selection-foreground = #ffffff
palette = 0=#000000
palette = 1=#f78166
palette = 2=#56d364
palette = 3=#e3b341
palette = 4=#6ca4f8
palette = 5=#db61a2
palette = 6=#2b7489
palette = 7=#ffffff
palette = 8=#4d4d4d
palette = 9=#f78166
palette = 10=#56d364
palette = 11=#e3b341
palette = 12=#6ca4f8
palette = 13=#db61a2
palette = 14=#2b7489
palette = 15=#ffffff

# Mouse
right-click-action = paste
mouse-hide-while-typing = true
focus-follows-mouse = true

# Keybinds
keybind = ctrl+o>v=new_split:right
keybind = ctrl+o>s=new_split:down
keybind = ctrl+o>r=reload_config
keybind = ctrl+o>n=new_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+alt+h=goto_split:left
keybind = ctrl+alt+j=goto_split:down
keybind = ctrl+alt+k=goto_split:up
keybind = ctrl+alt+l=goto_split:right
keybind = ctrl+o>z=toggle_split_zoom
