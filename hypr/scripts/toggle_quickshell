#!/bin/bash

# Script para hacer toggle de la barra de quickshell
# Detecta si quickshell está corriendo y lo detiene/inicia según corresponda

CONFIG_DIR="$HOME/.config/quickshell"

if pgrep -x "quickshell" > /dev/null; then
    # Quickshell está corriendo, lo matamos
    pkill quickshell
    echo "Quickshell oculto"
else
    # Quickshell no está corriendo, lo iniciamos
    quickshell -c "$CONFIG_DIR" &
    echo "Quickshell mostrado"
fi
