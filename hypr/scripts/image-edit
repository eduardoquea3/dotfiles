#!/usr/bin/env bash

set -euo pipefail

image_file=${1:-}
if [[ -z $image_file ]]; then
    exit 1
fi

if command -v satty >/dev/null 2>&1; then
    exec satty --filename "$image_file" --copy-command wl-copy
fi

if command -v swappy >/dev/null 2>&1; then
    exec swappy -f "$image_file"
fi

echo "No image editor found: satty or swappy is required" >&2
exit 127
