/**
 * ChillPill application launcher.
 * Keep the layout compact and centered so the app list stays the focus.
 */

* {
  font: "JetBrainsMono Nerd Font 10";
  launcher-bg: #1a1a1a;
  launcher-surface: #252525;
  launcher-surface-alt: #262626;
  launcher-fg: #d0d0d0;
  launcher-muted: #888888;
  launcher-accent: #c4c4c4;
  launcher-accent-soft: rgba(196, 196, 196, 0.12);
}

configuration {
  modi: "drun";
  icon-theme: "Papirus-Dark";
  application-fallback-icon: "Adwaita";
  show-icons: true;
  drun-display-format: "{name}";
  disable-history: true;
  sidebar-mode: false;
  hover-select: true;
}

window {
  transparency: "real";
  location: center;
  anchor: center;
  fullscreen: false;
  width: 360px;
  height: 380px;
  x-offset: 0px;
  y-offset: 0px;
  enabled: true;
  border: 1px;
  border-color: #333333;
  border-radius: 19px;
  cursor: default;
  background-color: @launcher-bg;
}

mainbox {
  enabled: true;
  spacing: 0px;
  padding: 12px;
  background-color: transparent;
  orientation: vertical;
  children: [ "headerbar", "inputbar", "listbox" ];
}

headerbar {
  enabled: true;
  expand: false;
  spacing: 8px;
  padding: 2px 4px 10px 4px;
  background-color: transparent;
  orientation: horizontal;
  children: [ "textbox-header", "num-filtered-rows", "textbox-num-sep", "num-rows" ];
}

textbox-header {
  enabled: true;
  expand: true;
  str: "Applications";
  text-color: @launcher-fg;
  background-color: transparent;
  font-size: 12;
  vertical-align: 0.5;
}

num-filtered-rows,
textbox-num-sep,
num-rows {
  enabled: true;
  expand: false;
  text-color: @launcher-muted;
  background-color: transparent;
  font-size: 9;
  vertical-align: 0.5;
}

textbox-num-sep {
  str: "/";
  text-color: @launcher-accent;
}

inputbar {
  enabled: true;
  expand: false;
  spacing: 10px;
  padding: 7px 10px;
  background-color: @launcher-surface;
  text-color: @launcher-fg;
  orientation: horizontal;
  children: [ "textbox-search", "entry" ];
  border-radius: 8px;
}

textbox-search {
  enabled: true;
  expand: false;
  str: "󰍉";
  padding: 0px 4px 0px 0px;
  text-color: @launcher-accent;
  background-color: transparent;
  font-size: 12;
  vertical-align: 0.5;
}

entry {
  enabled: true;
  expand: true;
  padding: 0px;
  background-color: transparent;
  text-color: @launcher-fg;
  cursor: text;
  placeholder: "Search applications...";
  placeholder-color: @launcher-muted;
  font-size: 10;
  vertical-align: 0.5;
}

listbox {
  expand: true;
  spacing: 0px;
  padding: 10px 0px 0px 0px;
  background-color: transparent;
  orientation: vertical;
  children: [ "listview" ];
}

listview {
  enabled: true;
  columns: 1;
  lines: 7;
  cycle: true;
  dynamic: true;
  scrollbar: false;
  layout: vertical;
  reverse: false;
  fixed-height: true;
  fixed-columns: true;
  spacing: 3px;
  background-color: transparent;
  text-color: @launcher-fg;
  cursor: default;
}

element {
  enabled: true;
  spacing: 8px;
  padding: 5px 8px;
  border: 0px;
  border-radius: 9px;
  background-color: transparent;
  text-color: @launcher-fg;
  cursor: pointer;
}

element normal.normal,
element alternate.normal {
  background-color: transparent;
  text-color: @launcher-fg;
  opacity: 1.0;
}

element selected.normal,
element selected.active,
element selected.urgent {
  background-color: @launcher-accent-soft;
  border: 0px 0px 0px 2px;
  border-color: @launcher-accent;
  text-color: @launcher-fg;
  opacity: 1.0;
}

element-icon {
  background-color: transparent;
  text-color: inherit;
  size: 24px;
  cursor: inherit;
  vertical-align: 0.5;
}

element-text {
  enabled: true;
  expand: true;
  background-color: transparent;
  text-color: inherit;
  cursor: inherit;
  vertical-align: 0.5;
  horizontal-align: 0;
  font-size: 10;
}
