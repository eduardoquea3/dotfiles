* {
  font: "DankMono Nerd Font";
}

configuration {
  modi: "drun";
  icon-theme: "Papirus-Dark";
  application-fallback-icon: "Adwaita";
  show-icons: true;
  drun-display-format: "{name}";
  disable-history: true;
  sidebar-mode: false;
  hover-select: true;
}

@import "theme.rasi"

window {
  transparency: "real";
  location: east;
  anchor: east;
  fullscreen: false;
  width: 280px;
  height: 100%;
  x-offset: 0px;
  y-offset: 0px;
  enabled: true;
  border-radius: 0px;
  cursor: "default";
  background-color: @bg;
}

mainbox {
  enabled: true;
  spacing: 0px;
  background-color: transparent;
  orientation: vertical;
  children: [ "listbox" ];
}

listbox {
  spacing: 12px;
  padding: 20px 15px;
  background-color: transparent;
  orientation: vertical;
  children: [ "listview" ];
}

listview {
  enabled: true;
  columns: 2;
  lines: 8;
  cycle: true;
  dynamic: true;
  scrollbar: true;
  spacing: 10px;
  background-color: transparent;
  text-color: @fg;
  cursor: "default";
}

element {
  enabled: true;
  spacing: 8px;
  padding: 12px 8px;
  border-radius: 8px;
  background-color: transparent;
  text-color: @fg;
  cursor: pointer;
}

element.normal.normal {
  background-color: inherit;
  text-color: inherit;
  opacity: 0.7;
}

element.selected.normal {
  background-color: @accent;
  text-color: @bg;
  border-radius: 8px;
  opacity: 1.0;
}

element-icon {
  background-color: transparent;
  text-color: inherit;
  size: 40px;
  cursor: inherit;
  vertical-align: 0.5;
}

element-text {
  enabled: true;
  background-color: transparent;
  text-color: inherit;
  cursor: inherit;
  vertical-align: 0.5;
  horizontal-align: 0.5;
  font-size: 10;
}

scrollbar {
  enabled: true;
  handle-color: @accent;
  background-color: @bg-alt;
  border-radius: 3px;
}
